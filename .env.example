# Copy to .env (or export in your shell). NEVER commit the real file.
# Скопируй в .env (или сделай export). Настоящий файл в git НЕ кладём.

# --- Mode: dryrun (default, paper) or live ---
RUN_MODE=dryrun

# --- Live trading (frozen by default; kill-switch blocks it anyway) ---
# Живая торговля. По умолчанию заморожена, kill-switch всё равно её блокирует.
CONFIRM_LIVE=0
WALLET_ADDRESS=0x0000000000000000000000000000000000000000
WALLET_PRIVATE_KEY=
# Hyperliquid API-wallet (agent key) instead of the main key — safer:
HL_API_PRIVATE_KEY=

# --- Kill-switch report path (optional) ---
WF_REPORT_PATH=data/reports/wf_latest.json

# --- Telegram notifications / remote stop (optional) ---
# Also accepted from .env.tg (see scripts/tg_notify.sh --help)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM helpers (optional, research only) ---
LLM_API_KEY=
OPENROUTER_API_KEY=
SGLANG_MODEL_PATH=
ADVISOR_LLM=http://127.0.0.1:30000/v1
ADVISOR_MODEL=default
